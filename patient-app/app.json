{
  "expo": {
    "name": "MediKiosk Patient",
    "slug": "medikiosk-patient",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F766E"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "MediKiosk needs camera access to scan prescriptions and lab reports"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F766E"
      },
      "permissions": ["CAMERA"]
    },
    "extra": {
      "apiUrl": "http://localhost:3001/api/v1"
    }
  }
}
